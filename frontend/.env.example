# Frontend Environment Variables (.env)

# Backend API Configuration
VITE_BACKEND_URL_LOCAL=http://localhost:3000
VITE_BACKEND_URL_PRODUCTION=https://job-cohortlab-backend.onrender.com

# Environment (development/production)
VITE_NODE_ENV=production

# API Base URL - This should match your deployed backend URL
VITE_API_BASE_URL=https://job-cohortlab-backend.onrender.com